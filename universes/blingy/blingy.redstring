        "goal": {
          "goal": "Verrijk het Tulpenmanie-web met diepgaande Nederlandse definitiewebs voor de belangrijkste historische, economische en biologische concepten.",
          "satisfiedWhen": "Ten minste 5 kernknooppunten (waaronder Windhandel, Semper Augustus, Tulpenmozaïekvirus, Bloemisten en Marktcrash van 1637) bezitten een definitiegrafiek met minimaal 5 onderling verbonden Nederlandse componenten.",
          "failsIf": [
            "minder dan 5 knooppunten een definitiegrafiek krijgen",
            "definitiegrafieken minder dan 5 knooppunten bevatten",
            "de nieuwe knooppunten en relaties niet in het Nederlands zijn opgesteld",
            "er geen onderlinge verbindingen tussen de subcomponenten zijn gelegd"
          ],
          "status": "open",
          "verdict": ""
        },
        "graphId": "graph-1794106832391-ztdxcr"
      }
