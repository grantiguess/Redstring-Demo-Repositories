      "graph-1793953067255-etg4zh": {
        "@type": "redstring:SpatialGraph",
        "@id": "urn:redstring:id:graph-1793953067255-etg4zh",
        "rdfs:label": "ATP",
        "rdfs:comment": "The cell's energy currency: adenosine carrying a chain of three phosphate groups. Spending energy snaps phosphates off, and the adenosine left behind is what makes you feel tired.",
        "redstring:definingNodeIds": [
          "04da4ed1-96cb-4690-81e6-fc840a8acd6f"
        ],
        "redstring:edgeIds": [
