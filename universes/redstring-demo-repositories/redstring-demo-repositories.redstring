    "graph-1793953067255-etg4zh": {
      "id": "graph-1793953067255-etg4zh",
      "name": "ATP",
      "description": "The cell's energy currency: adenosine carrying a chain of three phosphate groups. Spending energy snaps phosphates off, and the adenosine left behind is what makes you feel tired.",
      "nodeCount": 2,
      "edgeCount": 1,
      "density": 0.5,
      "quality": "dense",
      "score": 44,
