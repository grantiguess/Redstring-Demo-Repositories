      "graph-1793953122173-awypmv": {
        "@type": "redstring:SpatialGraph",
        "@id": "urn:redstring:id:graph-1793953122173-awypmv",
        "rdfs:label": "Synapse",
        "rdfs:comment": "The gap between neurons. Adenosine from spent ATP piles up here over the day and binds A1 receptors, telling the neuron to slow down.",
        "redstring:definingNodeIds": [
          "edef2550-83f5-4fcd-9068-8d35c199c540"
        ],
