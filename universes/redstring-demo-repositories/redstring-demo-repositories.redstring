  "graphSummaries": {
    "graph-1793953049884-27a4z8": {
      "id": "graph-1793953049884-27a4z8",
      "name": "Purine",
      "description": "The two-ring nitrogen skeleton shared by adenine, caffeine's xanthine core, and uric acid. The punchline of the demo: the same part sits in your DNA, your energy supply, your tiredness and your coffee.",
      "nodeCount": 2,
      "edgeCount": 1,
      "density": 0.5,
