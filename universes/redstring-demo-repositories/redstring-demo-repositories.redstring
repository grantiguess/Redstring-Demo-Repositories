      "graph-1793953062318-9wswou": {
        "@type": "redstring:SpatialGraph",
        "@id": "urn:redstring:id:graph-1793953062318-9wswou",
        "rdfs:label": "Adenosine",
        "rdfs:comment": "Adenine bonded to the sugar ribose. It's what's left when a neuron spends ATP, and it builds up between neurons as the chemical signal of tiredness.",
