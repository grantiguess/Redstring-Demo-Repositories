    "graph-1793953062318-9wswou": {
      "id": "graph-1793953062318-9wswou",
      "name": "Adenosine",
      "description": "Adenine bonded to the sugar ribose. It's what's left when a neuron spends ATP, and it builds up between neurons as the chemical signal of tiredness.",
      "nodeCount": 2,
      "edgeCount": 1,
      "density": 0.5,
      "quality": "dense",
      "score": 44,
