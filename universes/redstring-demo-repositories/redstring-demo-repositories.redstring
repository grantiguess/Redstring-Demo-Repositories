    "graph-1793953091715-ghuufc": {
      "id": "graph-1793953091715-ghuufc",
      "name": "Caffeine",
      "description": "A xanthine: the purine skeleton with three methyl groups and two carbonyl oxygens. It looks enough like adenine's purine that it fits the receptors adenosine is meant for.",
      "nodeCount": 3,
      "edgeCount": 2,
